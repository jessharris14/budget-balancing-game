{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",

        "phase": {
          ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val()",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'overview' || newData.val() === 'gameOverview' || newData.val() === 'publicHearing' || newData.val() === 'rollForChair' || newData.val() === 'rankPriorities' || newData.val() === 'mainGame' || newData.val() === 'debrief'"
        },
        "clock": {
          ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val()"
        },
        "settings": {
          ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val()"
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === null || newData.isNumber()"
          }
        },

        "commissions": {
          "$commissionId": {
            "name": {
              ".write": "auth != null && !data.exists()",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "members": {
              "managerAdminId": {
                ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (newData.val() === null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val()))",
                ".validate": "newData.val() === null || newData.val() === auth.uid"
              },
              "chairId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val() && (!data.exists() || newData.val() === null)"
              },
              "commissionerIds": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid",
                  ".validate": "newData.val() === true"
                }
              }
            },
            "chairRoll": {
              ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val()"
            },
            "priority": {
              "selectedCardId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('chairId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
              },
              "funded": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
              }
            },
            "activeChallenge": {
              ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
            },
            "activeMotion": {
              ".write": "auth != null && root.child('sessions').child($code).child('phase').val() !== 'debrief' && (auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() || (root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('commissionerIds').child(auth.uid).val() === true && !data.exists() && newData.exists() && root.child('sessions').child($code).child('commissions').child($commissionId).child('chairHighlightedCardId').val() === null && root.child('sessions').child($code).child('commissions').child($commissionId).child('activeBallotId').val() === null) || (root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('commissionerIds').child(auth.uid).val() === true && data.exists() && !data.child('secondedBy').exists() && newData.child('secondedBy').val() === auth.uid && auth.uid !== data.child('movedBy').val()) || (auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('chairId').val() && data.exists() && !newData.exists()))"
            },
            "challengesApplied": {
              "$cardId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'",
                ".validate": "newData.isNumber()"
              }
            },

            "ledger": {
              ".write": "auth != null && (auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() || auth.uid === root.child('sessions').child($code).child('facilitatorId').val()) && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
            },
            "cardsInPlay": {
              "$cardId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
              }
            },
            "cardsLockedOut": {
              "$cardId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
              }
            },
            "challengeLedgerAppliedAt": {
              ".write": "auth != null && (auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() || auth.uid === root.child('sessions').child($code).child('facilitatorId').val()) && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
            },
            "chairFreeCardUsed": {
              ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && data.val() === false && newData.val() === true && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
            },

            "chairHighlightedCardId": {
              ".write": "auth != null && root.child('sessions').child($code).child('phase').val() !== 'debrief' && (auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('chairId').val() || auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val()) && (newData.val() === null || newData.val() === root.child('sessions').child($code).child('commissions').child($commissionId).child('activeMotion').child('cardId').val() || (root.child('sessions').child($code).child('commissions').child($commissionId).child('activeMotion').val() === null && root.child('sessions').child($code).child('commissions').child($commissionId).child('activeBallotId').val() === null))"
            },
            "debateTimerEndsAt": {
              ".write": "auth != null && root.child('sessions').child($code).child('phase').val() !== 'debrief' && (auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('chairId').val() || auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val())"
            },

            "decisionsLog": {
              "$entryId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
              }
            },
            "failedMotionsLog": {
              "$entryId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
              }
            },

            "publicTrustTally": {
              ".write": "auth != null && root.child('sessions').child($code).child('publicHearingSpeakers').child(auth.uid).child('commissionId').val() === $commissionId && root.child('sessions').child($code).child('phase').val() !== 'debrief'",
              ".validate": "(!data.exists() && newData.val() === 0) || (data.exists() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1))"
            },

            "activeBallotId": {
              ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'"
            },
            "ballotMeasures": {
              "$ballotId": {
                ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('commissions').child($commissionId).child('members').child('managerAdminId').val() && root.child('sessions').child($code).child('phase').val() !== 'debrief'",
                "yesCount": {
                  ".write": "auth != null && root.child('sessions').child($code).child('publicHearingSpeakers').child(auth.uid).child('commissionId').val() === $commissionId && root.child('sessions').child($code).child('phase').val() !== 'debrief' && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
                },
                "noCount": {
                  ".write": "auth != null && root.child('sessions').child($code).child('publicHearingSpeakers').child(auth.uid).child('commissionId').val() === $commissionId && root.child('sessions').child($code).child('phase').val() !== 'debrief' && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
                }
              }
            },

            "finalScore": {
              ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val() && root.child('sessions').child($code).child('phase').val() === 'debrief'",
              ".validate": "!data.exists()"
            }
          }
        },

        "publicHearingSpeakers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('sessions').child($code).child('publicHearingSpeakers').numChildren() < 60",
            ".validate": "newData.child('id').val() === $uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30",
            "assignedPrompts": {
              ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val()"
            },
            "rerollCount": {
              ".write": "auth != null && auth.uid === root.child('sessions').child($code).child('facilitatorId').val()"
            },
            "endorsementsUsed": {
              ".write": "auth != null && auth.uid === $uid",
              "0": {
                ".validate": "!data.exists() && root.child('sessions').child($code).child('phase').val() !== 'debrief' && newData.hasChildren(['type', 'timestamp']) && (newData.child('type').val() === 'endorse' || newData.child('type').val() === 'oppose')"
              },
              "1": {
                ".validate": "!data.exists() && root.child('sessions').child($code).child('phase').val() !== 'debrief' && newData.hasChildren(['type', 'timestamp']) && (newData.child('type').val() === 'endorse' || newData.child('type').val() === 'oppose')"
              },
              "2": {
                ".validate": "!data.exists() && root.child('sessions').child($code).child('phase').val() !== 'debrief' && newData.hasChildren(['type', 'timestamp']) && (newData.child('type').val() === 'endorse' || newData.child('type').val() === 'oppose')"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },

        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('sessions').child($code).child('participants').numChildren() < 60",
            ".validate": "newData.child('uid').val() === $uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && (newData.child('role').val() === 'facilitator' || newData.child('role').val() === 'managerAdmin' || newData.child('role').val() === 'commissioner' || newData.child('role').val() === 'publicHearingSpeaker')"
          }
        }
      }
    },

    "ballotVotes": {
      "$code": {
        "$commissionId": {
          "$ballotId": {
            "$speakerUid": {
              ".read": "auth != null && auth.uid === $speakerUid",
              ".write": "auth != null && auth.uid === $speakerUid && !data.exists() && (newData.val() === 'yes' || newData.val() === 'no') && root.child('sessions').child($code).child('phase').val() !== 'debrief' && root.child('sessions').child($code).child('commissions').child($commissionId).child('activeBallotId').val() === $ballotId && root.child('sessions').child($code).child('commissions').child($commissionId).child('ballotMeasures').child($ballotId).child('openedAt').val() !== null && root.child('sessions').child($code).child('publicHearingSpeakers').child(auth.uid).child('commissionId').val() === $commissionId"
            }
          }
        }
      }
    }
  }
}
