# Firebase Web SDK config — copy this file to .env and fill in real values.
# Get these from Firebase Console > Project Settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database URL — Firebase Console > Realtime Database > top of the data viewer.
# e.g. https://<project-id>-default-rtdb.firebaseio.com or a region-specific *.firebasedatabase.app URL
VITE_FIREBASE_DATABASE_URL=

# App Check (Phase 8.4) — optional, App Check stays off if unset.
# Public reCAPTCHA v3 SITE key (not the secret key) from
# https://www.google.com/recaptcha/admin — register it in Firebase Console
# > App Check > Apps > your web app > reCAPTCHA v3 first, see the Phase 8.4
# delivery notes for the exact steps.
VITE_RECAPTCHA_SITE_KEY=

# Local dev / CI only — never set in a real deployment. "true" to have the
# SDK print a fresh debug token to the browser console (register it once in
# Console > App Check > Apps > ⋮ > "Manage debug tokens"), or an
# already-registered token string.
VITE_APPCHECK_DEBUG_TOKEN=
